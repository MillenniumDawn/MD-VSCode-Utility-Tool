{
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"target": "es2020",
		"lib": [
			"es2020"
		],
		"outDir": "out-test",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"mocha"
		]
	},
	"include": [
		"src/test/**/*.ts"
	],
	"exclude": [
		"src/test/webview"
	],
}
