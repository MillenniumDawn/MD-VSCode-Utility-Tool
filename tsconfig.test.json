{
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": [
			"es2022"
		],
		"outDir": "out-test",
		"rootDir": ".",
		"sourceMap": true,
		"strict": true,
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"mocha"
		]
	},
	"include": [
		"src/**/*.ts",
		"i18n/en.ts"
	],
	"exclude": [
		"src/test/webview"
	]
}
