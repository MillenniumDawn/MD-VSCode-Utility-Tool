{
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": [
			"es2022",
			"DOM"
		],
		"outDir": "out-test-webview",
		"rootDir": ".",
		"sourceMap": true,
		"incremental": true,
		"tsBuildInfoFile": "./out-test-webview/.tsbuildinfo",
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"mocha"
		]
	},
	"include": [
		"src/def.d.ts",
		"src/test/webview/**/*.ts"
	]
}
