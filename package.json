{
	"name": "hearts-of-iron-iv-utilities-2026",
	"displayName": "%hoi4modutilities.displayName%",
	"description": "Utilities for Heart of Iron IV mods developers",
	"version": "1.1.36",
	"author": "TheGeneral",
	"publisher": "MilleniumDawnModTeam",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/MillenniumDawn/MD-VSCode-Utility-Tool"
	},
	"engines": {
		"node": ">=24",
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"mod",
		"paradox",
		"hoi",
		"Heart of Iron"
	],
	"activationEvents": [
		"onCustomEditor:mdhoi4utilities.dds",
		"onCustomEditor:mdhoi4utilities.tga",
		"onWebviewPanel:mdftpreview",
		"onWebviewPanel:mdworldmappreview",
		"workspaceContains:**/*.gfx",
		"workspaceContains:common/characters/*.txt",
		"workspaceContains:common/decisions/*.txt",
		"workspaceContains:common/ideas/*.txt",
		"workspaceContains:common/national_focus/*.txt",
		"workspaceContains:common/technologies/*.txt",
		"workspaceContains:events/*.txt",
		"workspaceContains:map/default.map"
	],
	"main": "./dist/extension.js",
	"browser": "./dist/web-extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true,
			"restrictedConfigurations": [
				"mdHoi4Utilities.installPath",
				"mdHoi4Utilities.modFile",
				"mdHoi4Utilities.parentModPaths",
				"mdHoi4Utilities.userDataPath",
				"mdHoi4Utilities.inlayWindowGfxRoots",
				"mdHoi4Utilities.technologyGfxRoots"
			]
		}
	},
	"locale": "%hoi4modutilities.locale%",
	"contributes": {
		"configuration": [
			{
				"title": "%hoi4modutilities.displayName%",
				"properties": {
					"mdHoi4Utilities.installPath": {
						"title": "%hoi4modutilities.installPath.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.installPath.desc%"
					},
					"mdHoi4Utilities.loadDlcContents": {
						"title": "%hoi4modutilities.loadDlcContents.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.loadDlcContents.desc%"
					},
					"mdHoi4Utilities.modFile": {
						"title": "%hoi4modutilities.modFile.title%",
						"type": "string",
						"default": "",
						"description": "%hoi4modutilities.modFile.desc%"
					},
					"mdHoi4Utilities.parentModPaths": {
						"title": "Parent mod paths",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "Absolute folders of the mods this workspace extends (for a submod), searched in order after the workspace folders and before the Hearts of Iron IV install and DLCs. The mods named in the selected .mod file's dependencies are found through the launcher's mod registry and appended after these; an entry here wins over the registry for the same mod."
					},
					"mdHoi4Utilities.userDataPath": {
						"title": "User data path",
						"type": "string",
						"default": "",
						"description": "The Hearts of Iron IV user data folder, the one holding dlc_load.json and the mod folder the launcher writes. Used to resolve the dependencies of the selected .mod file to folders. Found automatically when empty."
					},
					"mdHoi4Utilities.enableSupplyArea": {
						"title": "%hoi4modutilities.enableSupplyArea.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.enableSupplyArea.desc%"
					},
					"mdHoi4Utilities.previewLocalisation": {
						"title": "%hoi4modutilities.previewLocalisation.title%",
						"type": "string",
						"default": "English",
						"enum": [
							"Brazilian Portuguese",
							"English",
							"French",
							"German",
							"Japanese",
							"Polish",
							"Russian",
							"Simplified Chinese",
							"Spanish"
						],
						"description": "%hoi4modutilities.previewLocalisation.desc%"
					},
					"mdHoi4Utilities.inlayWindowGfxRoots": {
						"title": "Focus inlay window GFX roots",
						"type": "array",
						"default": [
							"interface/scripted_gui"
						],
						"items": {
							"type": "string"
						},
						"description": "Workspace/mod/HOI4-relative root folders to scan recursively for .gfx files used by focus inlay windows."
					},
					"mdHoi4Utilities.technologyGfxRoots": {
						"title": "Technology GFX roots",
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"description": "Workspace/mod-relative root folders to scan recursively for .gfx files used by the technology tree preview, including country-specific technology icons (e.g. \"interface/technologies\")."
					},
					"mdHoi4Utilities.technologyCountryIcons": {
						"title": "Technology tree: country-specific icons",
						"type": "boolean",
						"default": false,
						"description": "Add a country selector to the technology tree preview and prefer that country's icons (GFX_<TAG>_<technology>) over the generic ones, the way the game does. Needs the GFX index to list the countries."
					},
					"mdHoi4Utilities.previewWheel": {
						"title": "Previews: what the mouse wheel does",
						"type": "string",
						"default": "auto",
						"enum": [
							"auto",
							"zoom",
							"scroll"
						],
						"enumDescriptions": [
							"Zoom when the wheel is a mouse wheel, scroll when it is a two-finger trackpad swipe.",
							"The wheel always zooms.",
							"The wheel always scrolls; zoom with Ctrl+wheel, the zoom buttons or the +/- keys."
						],
						"description": "What a plain mouse wheel does in the focus tree, technology, MIO, event and decision previews. Ctrl+wheel, the zoom buttons and the +/- keys zoom whatever this is set to. Reopen the preview after changing this."
					},
					"mdHoi4Utilities.worldMapRetainContextWhenHidden": {
						"title": "World map: keep webview in memory when hidden",
						"type": "boolean",
						"default": true,
						"description": "Keep the world map preview's webview loaded while the tab is hidden (faster to switch back, uses more memory). Turn off to free the webview when hidden and reload it on return, lowering memory use on large maps. The extension-host copy of the map is always released while hidden."
					},
					"mdHoi4Utilities.useConditionInFocus": {
						"title": "%hoi4modutilities.useConditionInFocus.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.useConditionInFocus.desc%"
					},
					"mdHoi4Utilities.eventTreePreview": {
						"title": "%hoi4modutilities.eventTreePreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.eventTreePreview.desc%"
					},
					"mdHoi4Utilities.ideaPreview": {
						"title": "%hoi4modutilities.ideaPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.ideaPreview.desc%"
					},
					"mdHoi4Utilities.decisionPreview": {
						"title": "%hoi4modutilities.decisionPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.decisionPreview.desc%"
					},
					"mdHoi4Utilities.characterPreview": {
						"title": "%hoi4modutilities.characterPreview.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.characterPreview.desc%"
					},
					"mdHoi4Utilities.ideaSwapIndex": {
						"title": "%hoi4modutilities.ideaSwapIndex.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.ideaSwapIndex.desc%"
					},
					"mdHoi4Utilities.sharedFocusIndex": {
						"title": "%hoi4modutilities.sharedFocusIndex.title%",
						"type": "boolean",
						"default": true,
						"description": "%hoi4modutilities.sharedFocusIndex.desc%"
					},
					"mdHoi4Utilities.gfxIndex": {
						"title": "%hoi4modutilities.gfxIndex.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.gfxIndex.desc%"
					},
					"mdHoi4Utilities.localisationIndex": {
						"title": "%hoi4modutilities.localisationIndex.title%",
						"type": "boolean",
						"default": false,
						"description": "%hoi4modutilities.localisationIndex.desc%"
					},
					"mdHoi4Utilities.imageDecodeWorkers": {
						"title": "%hoi4modutilities.imageDecodeWorkers.title%",
						"type": "number",
						"default": 4,
						"minimum": 1,
						"maximum": 16,
						"description": "%hoi4modutilities.imageDecodeWorkers.desc%"
					}
				}
			}
		],
		"commands": [
			{
				"command": "mdhoi4utilities.preview",
				"title": "%hoi4modutilities.preview.title%",
				"icon": {
					"dark": "static/preview_icon.png",
					"light": "static/preview_icon.png"
				},
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.selectmodfile",
				"title": "%hoi4modutilities.selectmodfile.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.previewworld",
				"title": "%hoi4modutilities.previewworld.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.scanreferences",
				"title": "%hoi4modutilities.scanreferences.title%",
				"icon": "$(references)",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.selecthoifolder",
				"title": "%hoi4modutilities.selecthoifolder.title%",
				"category": "%hoi4modutilities.category%"
			},
			{
				"command": "mdhoi4utilities.showindexstatus",
				"title": "%hoi4modutilities.showindexstatus.title%",
				"category": "%hoi4modutilities.category%"
			}
		],
		"customEditors": [
			{
				"viewType": "mdhoi4utilities.dds",
				"displayName": "%hoi4modutilities.dds.editorName%",
				"selector": [
					{
						"filenamePattern": "*.dds"
					}
				]
			},
			{
				"viewType": "mdhoi4utilities.tga",
				"displayName": "%hoi4modutilities.tga.editorName%",
				"selector": [
					{
						"filenamePattern": "*.tga"
					}
				]
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "mdhoi4utilities.preview",
					"when": "!shouldShowMdHoi4Preview && resourceExtname == '.txt' && !shouldHideMdHoi4Preview",
					"group": "navigation"
				},
				{
					"command": "mdhoi4utilities.preview",
					"when": "shouldShowMdHoi4Preview && resourceScheme != webview-panel",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "mdhoi4utilities.preview",
					"when": "!shouldHideMdHoi4Preview && resourceScheme != webview-panel"
				},
				{
					"command": "mdhoi4utilities.scanreferences",
					"when": "!mdHoi4MULoaded || mdHoi4PreviewType == event"
				},
				{
					"command": "mdhoi4utilities.selectmodfile"
				},
				{
					"command": "mdhoi4utilities.previewworld"
				},
				{
					"command": "mdhoi4utilities.selecthoifolder"
				},
				{
					"command": "mdhoi4utilities.showindexstatus"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch --progress",
		"web-ext": "serve --cors -l 5000 --ssl-cert \"%CERT_PATH%/localhost.cer\" --ssl-key \"%CERT_PATH%/localhost.key\"",
		"compile-ts": "tsc -d -p ./ --module commonjs",
		"compile-test": "tsc -p ./tsconfig.test.json",
		"lint": "eslint src webviewsrc scripts webpack.config.js eslint.config.cjs",
		"dupes": "jscpd",
		"bench": "npm run compile-test && node scripts/bench.js",
		"watch": "tsc -watch -p ./",
		"compile-test-webview": "tsc -p ./tsconfig.webview.test.json",
		"pretest": "node scripts/compile-tests.js",
		"test": "mocha --forbid-only --require ./out-test/src/test/_vscode_stub.js \"out-test/src/test/**/*.test.js\" \"out-test-webview/src/test/webview/**/*.test.js\" --exclude \"out-test/src/test/integration/**\"",
		"test:coverage": "c8 --reporter=text --reporter=lcov --reports-dir=coverage mocha --forbid-only --require ./out-test/src/test/_vscode_stub.js \"out-test/src/test/**/*.test.js\" \"out-test-webview/src/test/webview/**/*.test.js\" --exclude \"out-test/src/test/integration/**\"",
		"test:diff-coverage": "node scripts/diff-coverage.js",
		"test:integration": "node ./out-test/src/test/integration/runTest.js",
		"smoke:webviews": "node scripts/smoke-webviews.js",
		"clean": "rimraf dist out static out-test out-test-webview",
		"geni18n": "npm run compile-ts && node scripts/genzhi18n.js",
		"package": "vsce package",
		"package:pre-release": "vsce package --pre-release",
		"check-version": "node scripts/check-version.js",
		"prerelease-version": "node scripts/prerelease-version.js",
		"release-check": "node scripts/release-check.js",
		"pr-bullets": "node scripts/pr-bullets.js",
		"bump": "node scripts/bump-version.js",
		"package:patch": "npm version patch --no-git-tag-version && vsce package",
		"package:minor": "npm version minor --no-git-tag-version && vsce package",
		"package:major": "npm version major --no-git-tag-version && vsce package"
	},
	"c8": {
		"all": true,
		"include": [
			"out-test/src/**/*.js",
			"out-test-webview/webviewsrc/**/*.js"
		],
		"exclude": [
			"out-test/src/test/**",
			"out-test-webview/src/test/**"
		],
		"reporter": [
			"text",
			"lcov"
		],
		"reports-dir": "coverage",
		"check-coverage": true,
		"statements": 76,
		"lines": 76,
		"functions": 74,
		"branches": 78,
		"per-file": false
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/jsdom": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26",
		"@types/pngjs": "^6.0.5",
		"@types/vscode": "~1.137.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.62.1",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"adm-zip": "^0.6.1",
		"c8": "^12.0.0",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^10.10.0",
		"jscpd": "^5.2.1",
		"jsdom": "^30.0.1",
		"mocha": "^12.0.1",
		"ovsx": "^1.2.0",
		"raw-loader": "^4.0.2",
		"rimraf": "^6.1.3",
		"serve": "^14.2.0",
		"terser-webpack-plugin": "^5.3.11",
		"ts-loader": "^9.6.2",
		"tslib": "^2.2.0",
		"typescript": "^7.0.2",
		"webpack": "^5.111.0",
		"webpack-cli": "^7.2.3"
	},
	"overrides": {
		"mocha": {
			"diff": "^8.0.3",
			"serialize-javascript": "^7.0.5"
		}
	},
	"dependencies": {
		"@vscode/codicons": "^0.0.45",
		"assert": "^2.1.0",
		"browserify-zlib": "^0.2.0",
		"buffer": "^6.0.3",
		"js-yaml": "^5.4.2",
		"lodash": "^4.17.21",
		"path-browserify": "^1.0.1",
		"pngjs": "^7.0.0",
		"process": "^0.11.10",
		"rxjs": "^7.8.2",
		"stream-browserify": "^3.0.0",
		"tga": "^1.0.7",
		"url": "^0.11.4",
		"util": "^0.12.5"
	},
	"allowScripts": {
		"@vscode/vsce-sign@2.0.9": true,
		"keytar": false
	}
}
